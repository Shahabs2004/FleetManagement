@page "/reports/missions"
@using FleetManagement.Application.Authorization
@rendermode InteractiveServer
@attribute [FleetPermission(PermissionCatalog.Reports.View)]
@using System.Globalization
@using FleetManagement.Domain.Missions
@using FleetManagement.Domain.Drivers
@using FleetManagement.Domain.Vehicles
@using FleetManagement.Infrastructure.Configuration
@using FleetManagement.Infrastructure.Reporting
@using FleetManagement.Web.Security
@using Microsoft.JSInterop
@inject MissionReportService ReportService
@inject DriverManagementService DriverService
@inject VehicleManagementService VehicleService
@inject ILogger<MissionReportPage> Logger
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>گزارش عملکرد ناوگان</PageTitle>

<section class="admin-panel">
    <div class="eyebrow">گزارش‌گیری</div>
    <h1>گزارش عملکرد مأموریت‌ها</h1>
    <p>مأموریت‌های تقسیم‌شده در هر بخش به‌صورت یک رکورد مستقل محاسبه می‌شوند. مسافت فقط برای مأموریت‌هایی محاسبه می‌شود که هر دو کیلومترشمار شروع و پایان را داشته باشند.</p>

    <div class="report-filters">
        <div>
            <label>از تاریخ جلالی</label>
            <input @bind="_fromDate" placeholder="۱۴۰۵/۰۱/۰۱" />
        </div>
        <div>
            <label>تا تاریخ جلالی</label>
            <input @bind="_toDate" placeholder="۱۴۰۵/۱۲/۲۹" />
        </div>
        <div>
            <label>راننده</label>
            <select @bind="_driverId">
                <option value="">همه رانندگان</option>
                @foreach (var driver in _drivers)
                {
                    <option value="@driver.Id">@driver.FirstName @driver.LastName</option>
                }
            </select>
        </div>
        <div>
            <label>خودرو</label>
            <select @bind="_vehicleId">
                <option value="">همه خودروها</option>
                @foreach (var vehicle in _vehicles)
                {
                    <option value="@vehicle.Id">@vehicle.Brand @vehicle.Model - @vehicle.LicensePlate</option>
                }
            </select>
        </div>
        <div>
            <label>نوع مأموریت</label>
            <select @bind="_type">
                <option value="">همه</option>
                <option value="@((int)MissionType.Freight)">بار</option>
                <option value="@((int)MissionType.Passenger)">مسافر</option>
            </select>
        </div>
        <div>
            <label>وضعیت</label>
            <select @bind="_status">
                <option value="">همه وضعیت‌ها</option>
                @foreach (var status in Enum.GetValues<MissionStatus>())
                {
                    <option value="@((int)status)">@GetStatusName(status)</option>
                }
            </select>
        </div>
        <div>
            <label>واحد سازمانی درخواست‌کننده</label>
            <input @bind="_organizationalUnit" placeholder="همه واحدها" />
        </div>
        <button type="button" class="primary-button" @onclick="BuildReportAsync" disabled="@_busy">تهیه گزارش</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="setup-error">@_error</div>
    }

    @if (_report is not null)
    {
        <div class="driver-actions report-actions">
            <AuthorizeView Policy="@PermissionCatalog.Policy(PermissionCatalog.Reports.Export)">
                <Authorized>
                    <button type="button" class="primary-button" @onclick="ExportExcel">دریافت فایل Excel</button>
                </Authorized>
            </AuthorizeView>
            <button type="button" class="secondary-button" @onclick="PrintReportAsync">چاپ / ذخیره PDF</button>
        </div>
        <div class="report-summary-grid">
            <div class="report-summary-item"><strong>@ToPersian(_report.Drivers.Sum(row => row.MissionCount).ToString())</strong><span>تعداد مأموریت‌های رانندگان</span></div>
            <div class="report-summary-item"><strong>@ToPersian(_report.Drivers.Sum(row => row.TotalHours).ToString("0.0", CultureInfo.InvariantCulture))</strong><span>مجموع ساعت مأموریت</span></div>
            <div class="report-summary-item"><strong>@ToPersian(_report.FreightMissionCount.ToString())</strong><span>مأموریت بار</span></div>
            <div class="report-summary-item"><strong>@ToPersian(_report.PassengerMissionCount.ToString())</strong><span>مأموریت مسافر</span></div>
            <div class="report-summary-item"><strong>@ToPersian(_report.Decisions.ApprovedCount.ToString())</strong><span>درخواست تأییدشده</span></div>
            <div class="report-summary-item"><strong>@ToPersian(_report.Decisions.RejectedCount.ToString())</strong><span>درخواست ردشده</span></div>
        </div>

        <h2>مقایسه عملکرد رانندگان</h2>
        <p>مسافت، تعداد مأموریت و مجموع ساعت در کنار هم نمایش داده شده‌اند.</p>
        <div class="session-table-wrap">
            <table class="session-table">
                <thead><tr><th>راننده</th><th>مسافت (کیلومتر)</th><th>تعداد مأموریت</th><th>ساعت مأموریت</th></tr></thead>
                <tbody>
                    @foreach (var row in _report.Drivers)
                    {
                        <tr>
                            <td>@row.DriverName</td>
                            <td>@(row.TotalKilometers.HasValue ? ToPersian(row.TotalKilometers.Value.ToString()) : "ثبت نشده")</td>
                            <td>@ToPersian(row.MissionCount.ToString())</td>
                            <td>@ToPersian(row.TotalHours.ToString("0.0", CultureInfo.InvariantCulture))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h2>عملکرد خودروها</h2>
        <div class="session-table-wrap">
            <table class="session-table">
                <thead><tr><th>خودرو</th><th>مسافت (کیلومتر)</th><th>تعداد مأموریت</th></tr></thead>
                <tbody>
                    @foreach (var row in _report.Vehicles)
                    {
                        <tr>
                            <td>@row.VehicleName</td>
                            <td>@(row.TotalKilometers.HasValue ? ToPersian(row.TotalKilometers.Value.ToString()) : "ثبت نشده")</td>
                            <td>@ToPersian(row.MissionCount.ToString())</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h2>مسافت ماهانه رانندگان</h2>
        <div class="session-table-wrap">
            <table class="session-table">
                <thead><tr><th>راننده</th><th>سال جلالی</th><th>ماه</th><th>مسافت (کیلومتر)</th></tr></thead>
                <tbody>
                    @foreach (var row in _report.MonthlyDriverMileage)
                    {
                        <tr>
                            <td>@row.DriverName</td>
                            <td>@ToPersian(row.JalaliYear.ToString())</td>
                            <td>@ToPersian(row.JalaliMonth.ToString("00"))</td>
                            <td>@ToPersian(row.TotalKilometers.ToString())</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h2>مأموریت‌های لغوشده</h2>
        <div class="session-table-wrap">
            <table class="session-table">
                <thead><tr><th>شماره</th><th>عنوان</th><th>درخواست‌کننده</th><th>علت</th></tr></thead>
                <tbody>
                    @foreach (var row in _report.CancelledMissions)
                    {
                        <tr><td>@row.MissionNumber</td><td>@row.Title</td><td>@row.RequesterUsername</td><td>@row.Reason</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _busy;
    private string _fromDate = string.Empty;
    private string _toDate = string.Empty;
    private string _driverId = string.Empty;
    private string _vehicleId = string.Empty;
    private string _type = string.Empty;
    private string _status = string.Empty;
    private string _organizationalUnit = string.Empty;
    private string _error = string.Empty;
    private IReadOnlyList<Driver> _drivers = [];
    private IReadOnlyList<Vehicle> _vehicles = [];
    private MissionReportResult? _report;

    /// <summary>بارگذاری فهرست منابع فیلتر.</summary>
    protected override async Task OnInitializedAsync()
    {
        _drivers = await DriverService.SearchAsync(includeArchived: true);
        _vehicles = await VehicleService.SearchAsync(includeArchived: true);
    }

    /// <summary>دریافت فایل اکسل با فیلترهای جاری.</summary>
    private void ExportExcel()
    {
        var parameters = new List<string>();
        AddParameter(parameters, "from", ParseJalaliDate(_fromDate, endOfDay: false)?.ToString("O", CultureInfo.InvariantCulture));
        AddParameter(parameters, "to", ParseJalaliDate(_toDate, endOfDay: true)?.ToString("O", CultureInfo.InvariantCulture));
        AddParameter(parameters, "driverId", _driverId);
        AddParameter(parameters, "vehicleId", _vehicleId);
        AddParameter(parameters, "type", _type);
        AddParameter(parameters, "status", _status);
        AddParameter(parameters, "unit", _organizationalUnit);

        Navigation.NavigateTo(
            "/reports/missions/export.xlsx?" + string.Join("&", parameters),
            forceLoad: true);
    }

    /// <summary>افزودن پارامتر غیرخالی به آدرس خروجی.</summary>
    private static void AddParameter(List<string> parameters, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            parameters.Add($"{Uri.EscapeDataString(key)}={Uri.EscapeDataString(value)}");
        }
    }

    /// <summary>بازکردن پنجره چاپ مرورگر برای ذخیره گزارش به‌صورت PDF.</summary>
    private async Task PrintReportAsync() => await JS.InvokeVoidAsync("window.print");

    /// <summary>ساخت گزارش با فیلترهای انتخاب‌شده.</summary>
    private async Task BuildReportAsync()
    {
        _busy = true;
        _error = string.Empty;
        try
        {
            var filter = new MissionReportFilter
            {
                FromUtc = ParseJalaliDate(_fromDate, endOfDay: false),
                ToUtc = ParseJalaliDate(_toDate, endOfDay: true),
                DriverId = Guid.TryParse(_driverId, out var driver) ? driver : null,
                VehicleId = Guid.TryParse(_vehicleId, out var vehicle) ? vehicle : null,
                Type = int.TryParse(_type, out var type) && Enum.IsDefined((MissionType)type) ? (MissionType)type : null,
                Status = int.TryParse(_status, out var status) && Enum.IsDefined((MissionStatus)status) ? (MissionStatus)status : null,
                OrganizationalUnit = _organizationalUnit
            };

            _report = await ReportService.BuildAsync(filter);
        }
        catch (Exception exception)
        {
            var trackingId = Guid.NewGuid().ToString("N");
            Logger.LogError(exception, "تهیه گزارش مأموریت ناموفق بود. شناسه پیگیری: {TrackingId}", trackingId);
            _error = $"تهیه گزارش انجام نشد. شناسه پیگیری: {trackingId}";
            _report = null;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>تبدیل تاریخ جلالی ورودی به بازه UTC منطقه تهران.</summary>
    private static DateTimeOffset? ParseJalaliDate(string value, bool endOfDay)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var normalized = NormalizeDigits(value.Trim()).Replace('-', '/');
        var parts = normalized.Split('/');
        if (parts.Length != 3
            || !int.TryParse(parts[0], out var year)
            || !int.TryParse(parts[1], out var month)
            || !int.TryParse(parts[2], out var day))
        {
            throw new InvalidOperationException("تاریخ را به شکل سال/ماه/روز جلالی وارد کنید.");
        }

        var calendar = new PersianCalendar();
        var local = calendar.ToDateTime(year, month, day, endOfDay ? 23 : 0, endOfDay ? 59 : 0, endOfDay ? 59 : 0, endOfDay ? 999 : 0);
        if (endOfDay) local = local.AddMilliseconds(0).AddTicks(9999);

        TimeZoneInfo zone;
        try { zone = TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time"); }
        catch (TimeZoneNotFoundException) { zone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran"); }

        var utc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), zone);
        return new DateTimeOffset(utc, TimeSpan.Zero);
    }

    /// <summary>تبدیل ارقام فارسی و عربی به لاتین برای پردازش تاریخ.</summary>
    private static string NormalizeDigits(string value)
    {
        const string digits = "۰۱۲۳۴۵۶۷۸۹";
        const string arabic = "٠١٢٣٤٥٦٧٨٩";
        var result = value.ToCharArray();
        for (var index = 0; index < result.Length; index++)
        {
            var position = digits.IndexOf(result[index]);
            if (position >= 0) result[index] = (char)('0' + position);
            else
            {
                position = arabic.IndexOf(result[index]);
                if (position >= 0) result[index] = (char)('0' + position);
            }
        }
        return new string(result);
    }

    /// <summary>تبدیل ارقام برای نمایش فارسی.</summary>
    private static string ToPersian(string value)
    {
        const string latin = "0123456789";
        const string persian = "۰۱۲۳۴۵۶۷۸۹";
        return string.Create(value.Length, value, (destination, source) =>
        {
            for (var index = 0; index < source.Length; index++)
            {
                var digit = latin.IndexOf(source[index]);
                destination[index] = digit >= 0 ? persian[digit] : source[index];
            }
        });
    }

    /// <summary>عنوان فارسی وضعیت مأموریت.</summary>
    private static string GetStatusName(MissionStatus status) => status switch
    {
        MissionStatus.Pending => "در انتظار بررسی",
        MissionStatus.UnderReview => "در حال بررسی",
        MissionStatus.Confirmed => "تأیید شده",
        MissionStatus.Running => "در حال اجرا",
        MissionStatus.Completed => "پایان‌یافته",
        MissionStatus.Cancelled => "لغوشده",
        MissionStatus.Rejected => "ردشده",
        MissionStatus.WithdrawalPending => "در انتظار انصراف",
        _ => "نامشخص"
    };
}
