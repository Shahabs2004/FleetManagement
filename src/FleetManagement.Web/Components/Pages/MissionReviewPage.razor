    /// <summary>بررسی مجوز عملیاتی در سمت سرور.</summary>
    private async Task<bool> HasPermissionAsync(string policy)
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authorization = await AuthorizationService.AuthorizeAsync(state.User, policy);
        if (authorization.Succeeded) return true;
        _error = "شما مجوز لازم برای انجام این عملیات را ندارید.";
        return false;
    }

    /// <summary>اجرای امن عملیات و بارگذاری مجدد فهرست.</summary>
    private async Task ExecuteAsync(Func<string, Task> action, string operation, string requiredPermission)
    {
        if (!await HasPermissionAsync(requiredPermission)) return;
        _busy = true;
        _error = string.Empty;
        try
        {
            await action(await GetActorAsync());
            _reason = string.Empty;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ReportError(exception, operation);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>الزام ثبت علت تصمیم.</summary>
    private void EnsureReason()
    {
        if (string.IsNullOrWhiteSpace(_reason))
        {
            throw new InvalidOperationException("ثبت علت برای این عملیات الزامی است.");
        }
    }

    /// <summary>استخراج عامل از هویت جاری.</summary>
    private async Task<string> GetActorAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return auth.User.FindFirst("fleet:username")?.Value ?? auth.User.Identity?.Name ?? "unknown";
    }

    /// <summary>نمایش زمان جلالی تهران.</summary>
    /// <summary>محاسبه نزدیک‌ترین ساعت آینده تهران برای انتخاب زمان عملیات.</summary>
    private static string GetMinimumDateTimeInput()
    {
        TimeZoneInfo zone;
        try { zone = TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time"); }
        catch (TimeZoneNotFoundException) { zone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran"); }

        var now = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, zone);
        var local = new DateTime(now.Year, now.Month, now.Day, now.Hour, 0, 0);
        if (now.Minute > 0 || now.Second > 0 || now.Millisecond > 0)
        {
            local = local.AddHours(1);
        }

        return local.ToString("yyyy-MM-dd'T'HH:mm", CultureInfo.InvariantCulture);
    }

    private static string FormatTime(DateTimeOffset value)
    {
        TimeZoneInfo zone;
        try { zone = TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time"); }
        catch (TimeZoneNotFoundException) { zone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran"); }
        var local = TimeZoneInfo.ConvertTime(value, zone);
        var calendar = new System.Globalization.PersianCalendar();
        return $"{calendar.GetYear(local.DateTime):0000}/{calendar.GetMonth(local.DateTime):00}/{calendar.GetDayOfMonth(local.DateTime):00} ساعت {local.Hour:00}";
    }

