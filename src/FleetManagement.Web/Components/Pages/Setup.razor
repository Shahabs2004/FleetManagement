@page "/setup"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using FleetManagement.Infrastructure.Bootstrap
@inject IBootstrapStateStore BootstrapStateStore
@inject BootstrapSetupService BootstrapSetup
@inject SqlConnectionSetupService SqlSetup
@inject SqlDatabaseInitializer DatabaseInitializer
@inject FleetManagement.Infrastructure.Bootstrap.SqlAvailabilityService SqlAvailability
@inject FleetManagement.Infrastructure.Configuration.ActiveDirectorySettingsService ActiveDirectorySettings
@inject FleetManagement.Infrastructure.Configuration.ActiveDirectoryConnectionTester ActiveDirectoryTester
@inject FleetManagement.Infrastructure.Configuration.OrganizationSettingsService OrganizationSettings
@inject FleetManagement.Infrastructure.Configuration.SmsSettingsService SmsSettings
@inject ILogger<Setup> Logger

<PageTitle>راه‌اندازی سامانه</PageTitle>

<section class="setup-panel">
    <div class="eyebrow">راه‌اندازی اولیه</div>
    <h1>آماده‌سازی سامانه مدیریت ناوگان</h1>
    <p class="setup-intro">
        این فرایند فقط برای اولین راه‌اندازی است. اطلاعات اتصال SQL در فایل محافظت‌شده سرور
        نگهداری می‌شود تا در زمان قطعی پایگاه داده امکان بازیابی وجود داشته باشد.
    </p>

    @if (_isLoading)
    {
        <p>در حال بررسی وضعیت راه‌اندازی...</p>
    }
    else if (_setupCompleted)
    {
        <div class="setup-success">
            <strong>راه‌اندازی اولیه با موفقیت تکمیل شد.</strong>
            <p>کد اولیه باطل شده و مسیر راه‌اندازی قفل شده است. ورود عادی سامانه در مرحله بعدی توسعه فعال می‌شود.</p>
        </div>
    }
    else if (!_hasLocalAdministrator)
    {
        <div class="setup-step">
            <div class="step-caption">گام ۱ از ۵ · ایجاد مدیر محلی اضطراری</div>
            <p>کد یک‌بارمصرف را از فایل محدودشده روی Windows Server دریافت کنید.</p>

            <EditForm Model="_administratorModel" OnValidSubmit="CreateAdministratorAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="setup-code">کد یک‌بارمصرف راه‌اندازی</label>
                <InputText id="setup-code" @bind-Value="_administratorModel.SetupCode" autocomplete="off" />

                <label for="admin-user">نام کاربری مدیر محلی</label>
                <InputText id="admin-user" @bind-Value="_administratorModel.Username" autocomplete="username" />

                <label for="admin-password">رمز عبور مدیر محلی</label>
                <InputText id="admin-password" type="password" @bind-Value="_administratorModel.Password" autocomplete="new-password" />

                <label for="admin-confirm">تکرار رمز عبور</label>
                <InputText id="admin-confirm" type="password" @bind-Value="_administratorModel.ConfirmPassword" autocomplete="new-password" />

                <button type="submit" class="primary-button" disabled="@_isBusy">ایجاد مدیر محلی</button>
            </EditForm>
        </div>
    }
    else if (!_administratorVerified)
    {
        <div class="setup-step">
            <div class="step-caption">گام ۲ از ۵ · تأیید مدیر محلی</div>
            <p>حساب مدیر محلی ایجاد شده است. برای ادامه، هویت مدیر را دوباره تأیید کنید.</p>

            <EditForm Model="_verificationModel" OnValidSubmit="VerifyAdministratorAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="verify-user">نام کاربری مدیر محلی</label>
                <InputText id="verify-user" @bind-Value="_verificationModel.Username" autocomplete="username" />

                <label for="verify-password">رمز عبور مدیر محلی</label>
                <InputText id="verify-password" type="password" @bind-Value="_verificationModel.Password" autocomplete="current-password" />

                <button type="submit" class="primary-button" disabled="@_isBusy">تأیید و ادامه</button>
            </EditForm>
        </div>
    }
    else if (!_sqlReady)
    {
        <div class="setup-step">
            <div class="step-caption">گام ۲ از ۳ · اتصال و ایجاد پایگاه داده SQL Server</div>
            <p>حساب SQL باید مجوز اتصال به master و ایجاد پایگاه داده را داشته باشد.</p>

            <EditForm Model="_sqlModel" OnValidSubmit="ConfigureSqlAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="sql-server">نام سرور یا نمونه SQL</label>
                <InputText id="sql-server" @bind-Value="_sqlModel.Server" placeholder="مثلاً SERVER\SQLINSTANCE" />

                <label for="sql-database">نام پایگاه داده</label>
                <InputText id="sql-database" @bind-Value="_sqlModel.Database" />

                <label for="sql-user">نام کاربری SQL</label>
                <InputText id="sql-user" @bind-Value="_sqlModel.Username" autocomplete="username" />

                <label for="sql-password">رمز عبور SQL</label>
                <InputText id="sql-password" type="password" @bind-Value="_sqlModel.Password" autocomplete="new-password" />

                <label class="checkbox-line">
                    <InputCheckbox @bind-Value="_sqlModel.TrustServerCertificate" />
                    اعتماد به گواهی سرور SQL (فقط در صورت نیاز شبکه داخلی)
                </label>

                <button type="submit" class="primary-button" disabled="@_isBusy">
                    @(_isBusy ? "در حال اتصال و ایجاد جداول..." : "آزمایش اتصال و ایجاد پایگاه داده")
                </button>
            </EditForm>
        </div>
    }
    else if (!_adReady)
    {
        <div class="setup-step">
            <div class="step-caption">گام ۳ از ۵ · تنظیم Active Directory</div>
            <p>اطلاعات اتصال دایرکتوری و گروه‌های مجاز را وارد کنید. اگر AD موقتاً در دسترس نیست، می‌توانید این مرحله را رد کنید و بعداً تنظیمات را تکمیل کنید.</p>

            <EditForm Model="_adModel" OnValidSubmit="SaveAndTestActiveDirectoryAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="ad-domain">نام DNS دامنه</label>
                <InputText id="ad-domain" @bind-Value="_adModel.DomainDnsName" placeholder="مثلاً corp.example.local" />

                <label for="ad-server">سرور LDAP</label>
                <InputText id="ad-server" @bind-Value="_adModel.LdapServer" />

                <label for="ad-port">درگاه LDAP</label>
                <InputNumber id="ad-port" @bind-Value="_adModel.Port" />

                <label class="checkbox-line">
                    <InputCheckbox @bind-Value="_adModel.UseLdaps" />
                    استفاده از LDAPS امن
                </label>
                @if (!_adModel.UseLdaps)
                {
                    <div class="setup-error">هشدار: در حالت LDAP بدون TLS، اطلاعات حساب سرویس ممکن است در مسیر شبکه رمزنگاری نشوند. استفاده از LDAPS توصیه می‌شود.</div>
                }

                <label for="ad-base">Base Distinguished Name</label>
                <InputText id="ad-base" @bind-Value="_adModel.BaseDistinguishedName" placeholder="DC=corp,DC=example,DC=local" />

                <label for="ad-service-user">نام کاربری حساب سرویس AD</label>
                <InputText id="ad-service-user" @bind-Value="_adModel.ServiceAccountUsername" />

                <label for="ad-service-password">رمز حساب سرویس AD</label>
                <InputText id="ad-service-password" type="password" @bind-Value="_adModel.ServiceAccountPassword" autocomplete="new-password" />

                <label for="ad-ou-attribute">ویژگی واحد سازمانی در AD</label>
                <InputText id="ad-ou-attribute" @bind-Value="_adModel.OrganizationalUnitAttribute" />

                <label for="ad-groups">گروه‌های مجاز، هر خط به شکل نام گروه|Distinguished Name</label>
                <InputTextArea id="ad-groups" @bind-Value="_adModel.AllowedGroupsText" />

                <label class="checkbox-line">
                    <InputCheckbox @bind-Value="_adModel.UseWindowsIntegratedAuthentication" />
                    ورود یکپارچه ویندوز
                </label>

                <label class="checkbox-line">
                    <InputCheckbox @bind-Value="_adModel.AllowUsernamePasswordFallback" />
                    ورود جایگزین با نام کاربری و رمز AD
                </label>

                <button type="submit" class="primary-button" disabled="@_isBusy">
                    @(_isBusy ? "در حال آزمون اتصال AD..." : "ذخیره تنظیمات و آزمون اتصال AD")
                </button>
            </EditForm>

            <button type="button" class="secondary-button" @onclick="SkipActiveDirectoryAsync" disabled="@_isBusy">
                فعلاً رد کردن تنظیم AD
            </button>
        </div>
    }
    else if (!_organizationReady)
    {
        <div class="setup-step">
            <div class="step-caption">گام ۴ از ۵ · مشخصات سازمان</div>
            <p>نام سازمان در سربرگ سامانه، صفحه ورود و برگه مأموریت نمایش داده می‌شود.</p>

            <EditForm Model="_organizationModel" OnValidSubmit="SaveOrganizationAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="organization-name">نام سازمان</label>
                <InputText id="organization-name" @bind-Value="_organizationModel.OrganizationName" />

                <label for="organization-logo">نشان سازمان (PNG یا JPEG، حداکثر ۱٫۵ مگابایت)</label>
                <InputFile id="organization-logo" OnChange="LogoSelectedAsync" accept="image/png,image/jpeg" />

                @if (!string.IsNullOrWhiteSpace(_logoFileName))
                {
                    <p>فایل انتخاب‌شده: @_logoFileName</p>
                }

                <button type="submit" class="primary-button" disabled="@_isBusy">ذخیره مشخصات سازمان</button>
            </EditForm>
        </div>
    }
    else if (!_smsReady)
    {
        <div class="setup-step">
            <div class="step-caption">گام ۵ از ۵ · تنظیم پیامک ADP (اختیاری)</div>
            <p>تنظیم پیامک اختیاری است. در این مرحله هیچ پیامک آزمایشی ارسال نمی‌شود؛ اختلال پیامک مانع فعالیت سامانه نخواهد شد.</p>

            @if (!HasCurrentTechnicalAdministratorAccess())
            {
                <div class="setup-info">
                    این مرحله فقط برای مدیر فنی است. کد مستقل مدیر فنی را از فایل محافظت‌شده روی Windows Server دریافت کنید.
                    تأیید مدیر محلی به‌تنهایی اجازه مشاهده یا تغییر اطلاعات محرمانه پیامک را نمی‌دهد.
                </div>

                <EditForm Model="_technicalAdministratorModel" OnValidSubmit="VerifyTechnicalAdministratorAsync">
                    <DataAnnotationsValidator />
                    <label for="technical-admin-code">کد دسترسی مدیر فنی</label>
                    <InputText id="technical-admin-code" @bind-Value="_technicalAdministratorModel.Code" autocomplete="off" />
                    <button type="submit" class="primary-button" disabled="@_isBusy">تأیید دسترسی مدیر فنی</button>
                </EditForm>
            }
            else
            {
            <div class="setup-info">
                دسترسی مدیر فنی تأیید شده است. رمز و اطلاعات سرویس پیامک فقط در همین مرحله قابل مشاهده و تنظیم هستند.
            </div>
            <EditForm Model="_smsModel" OnValidSubmit="SaveSmsSettingsAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="sms-organization">شناسه سازمان در سرویس‌دهنده</label>
                <InputText id="sms-organization" @bind-Value="_smsModel.Organization" />

                <label for="sms-username">نام کاربری سرویس پیامک</label>
                <InputText id="sms-username" @bind-Value="_smsModel.Username" />

                <label for="sms-password">رمز سرویس پیامک</label>
                <InputText id="sms-password" type="password" @bind-Value="_smsModel.Password" autocomplete="new-password" />

                <label for="sms-source">شماره فرستنده ثابت</label>
                <InputText id="sms-source" @bind-Value="_smsModel.SourceNumber" />

                <label for="sms-retries">تعداد تلاش مجدد خطاهای موقت</label>
                <InputNumber id="sms-retries" @bind-Value="_smsModel.MaximumRetryCount" />

                <label for="sms-retry-interval">فاصله تلاش مجدد (ثانیه)</label>
                <InputNumber id="sms-retry-interval" @bind-Value="_smsModel.RetryIntervalSeconds" />

                <label for="sms-poll-interval">فاصله بررسی وضعیت تحویل (ثانیه)</label>
                <InputNumber id="sms-poll-interval" @bind-Value="_smsModel.StatusPollingIntervalSeconds" />

                <label for="sms-poll-count">حداکثر دفعات بررسی وضعیت</label>
                <InputNumber id="sms-poll-count" @bind-Value="_smsModel.MaximumStatusPollingAttempts" />

                <label for="sms-reminder">یادآوری پیش از شروع (دقیقه)</label>
                <InputNumber id="sms-reminder" @bind-Value="_smsModel.ReminderLeadMinutes" />

                <button type="submit" class="primary-button" disabled="@_isBusy">ذخیره تنظیمات پیامک</button>
            </EditForm>

            <button type="button" class="secondary-button" @onclick="SkipSmsSettingsAsync" disabled="@_isBusy">
                فعلاً بدون پیامک ادامه بده
            </button>
            }
        </div>
    }
    else
    {
        <div class="setup-step">
            <div class="step-caption">پایان راه‌اندازی اولیه</div>
            <p>تنظیمات اصلی ثبت شده‌اند. با تکمیل این مرحله، مسیر راه‌اندازی اولیه قفل می‌شود.</p>
            <button type="button" class="primary-button" @onclick="CompleteInitialSetupAsync" disabled="@_isBusy">
                تکمیل و قفل کردن راه‌اندازی
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="@(_isError ? "setup-error" : "setup-info")" role="status">
            @_message
        </div>
    }
</section>

@code {
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _hasLocalAdministrator;
    private bool _administratorVerified;
    private bool _sqlReady;
    private bool _adReady;
    private bool _organizationReady;
    private bool _smsReady;
    private bool _technicalAdministratorVerified;
    private DateTimeOffset? _technicalAdministratorVerifiedUntilUtc;
    // قفل تلاش مدیر فنی باید با بارگذاری مجدد صفحه یا ایجاد Circuit جدید دور زده نشود.
    // چون ویزارد فقط یک مدیر فنی دارد، شمارنده در سطح کل فرایند مشترک است.
    private const string TechnicalAdministratorAttemptKey = "technical:bootstrap";
    private bool _setupCompleted;
    private bool _isError;
    private string? _message;

    private readonly AdministratorModel _administratorModel = new();
    private readonly VerificationModel _verificationModel = new();
    private readonly SqlModel _sqlModel = new();
    private readonly ActiveDirectoryModel _adModel = new();
    private readonly OrganizationModel _organizationModel = new();
    private readonly SmsModel _smsModel = new();
    private readonly TechnicalAdministratorModel _technicalAdministratorModel = new();
    private string? _existingLogoBase64;
    private string? _existingLogoContentType;
    private string? _newLogoBase64;
    private string? _newLogoContentType;
    private string? _logoFileName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await BootstrapStateStore.ReadAsync();
            _hasLocalAdministrator = state.HasLocalAdministrator;
            _setupCompleted = state.SetupCompleted;
            _verificationModel.Username = state.LocalAdministratorUsername ?? string.Empty;
            _sqlReady = !string.IsNullOrWhiteSpace(state.SqlConnectionString)
                && await SqlAvailability.IsAvailableAsync();
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "بررسی وضعیت راه‌اندازی");
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ExpireTechnicalAdministratorAccess())
        {
            StateHasChanged();
        }
    }

    private bool ExpireTechnicalAdministratorAccess()
    {
        if (!_technicalAdministratorVerified
            || _technicalAdministratorVerifiedUntilUtc > DateTimeOffset.UtcNow)
        {
            return false;
        }

        _technicalAdministratorVerified = false;
        _technicalAdministratorVerifiedUntilUtc = null;
        _smsModel.Password = string.Empty;
        return true;
    }

    /// <summary>
    /// پس از تأیید مدیر، Migrationها و تنظیمات ذخیره‌شده را بارگذاری می‌کند.
    /// </summary>
    private async Task LoadExistingSettingsAsync()
    {
        var savedDirectorySettings = await ActiveDirectorySettings.GetAsync();
        if (savedDirectorySettings is not null)
        {
            _adModel.DomainDnsName = savedDirectorySettings.DomainDnsName;
            _adModel.LdapServer = savedDirectorySettings.LdapServer;
            _adModel.Port = savedDirectorySettings.Port;
            _adModel.UseLdaps = savedDirectorySettings.UseLdaps;
            _adModel.BaseDistinguishedName = savedDirectorySettings.BaseDistinguishedName;
            _adModel.ServiceAccountUsername = savedDirectorySettings.ServiceAccountUsername;
            _adModel.OrganizationalUnitAttribute = savedDirectorySettings.OrganizationalUnitAttribute;
            _adModel.UseWindowsIntegratedAuthentication = savedDirectorySettings.UseWindowsIntegratedAuthentication;
            _adModel.AllowUsernamePasswordFallback = savedDirectorySettings.AllowUsernamePasswordFallback;
            _adModel.AllowedGroupsText = string.Join(
                Environment.NewLine,
                savedDirectorySettings.AllowedGroups.Select(group => $"{group.Name}|{group.DistinguishedName}"));
            _adReady = savedDirectorySettings.IsConnectionVerified
                || await ActiveDirectorySettings.IsSkippedAsync();
        }
        else
        {
            _adReady = await ActiveDirectorySettings.IsSkippedAsync();
        }

        var savedOrganization = await OrganizationSettings.GetAsync();
        if (savedOrganization is not null)
        {
            _organizationModel.OrganizationName = savedOrganization.OrganizationName;
            _existingLogoBase64 = savedOrganization.LogoBase64;
            _existingLogoContentType = savedOrganization.LogoContentType;
            _organizationReady = true;
        }

        // فقط وجود تنظیمات بررسی می‌شود؛ اطلاعات حساب سرویس پیامک تا تأیید مدیر فنی
        // وارد مدل صفحه یا Circuit مدیر محلی نمی‌شود.
        _smsReady = await SmsSettings.HasConfigurationAsync()
            || await SmsSettings.IsSkippedAsync();
    }

    /// <summary>
    /// ایجاد حساب اضطراری مستقل از SQL و Active Directory.
    /// </summary>
    private async Task CreateAdministratorAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            if (_administratorModel.Password != _administratorModel.ConfirmPassword)
            {
                throw new InvalidOperationException("رمز عبور و تکرار آن یکسان نیستند.");
            }

            await BootstrapSetup.CreateLocalAdministratorAsync(
                _administratorModel.SetupCode,
                _administratorModel.Username,
                _administratorModel.Password);

            _hasLocalAdministrator = true;
            _verificationModel.Username = _administratorModel.Username;
            _administratorModel.SetupCode = string.Empty;
            _administratorModel.Password = string.Empty;
            _administratorModel.ConfirmPassword = string.Empty;
            _message = "حساب مدیر محلی ساخته شد. برای ادامه، ورود مدیر را تأیید کنید.";
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "ایجاد مدیر محلی");
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// تأیید مجدد مدیر محلی پیش از نمایش تنظیمات اتصال پایگاه داده.
    /// </summary>
    private async Task VerifyAdministratorAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            _administratorVerified = await BootstrapSetup.VerifyLocalAdministratorAsync(
                _verificationModel.Username,
                _verificationModel.Password);
            _verificationModel.Password = string.Empty;

            if (!_administratorVerified)
            {
                throw new UnauthorizedAccessException("نام کاربری یا رمز عبور مدیر محلی صحیح نیست.");
            }

            if (_sqlReady)
            {
                try
                {
                    await DatabaseInitializer.InitializeAsync();
                    await LoadExistingSettingsAsync();
                }
                catch
                {
                    _sqlReady = false;
                    throw;
                }
            }

            _message = "هویت مدیر تأیید شد.";
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "تأیید مدیر محلی");
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// آزمایش اتصال، ایجاد پایگاه داده، اجرای Migration و قفل کردن ویزارد.
    /// </summary>
    private async Task ConfigureSqlAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            await SqlSetup.TestAndSaveAsync(
                _sqlModel.Server,
                _sqlModel.Database,
                _sqlModel.Username,
                _sqlModel.Password,
                _sqlModel.TrustServerCertificate);

            await DatabaseInitializer.InitializeAsync();

            _sqlReady = true;
            _sqlModel.Password = string.Empty;
            _verificationModel.Password = string.Empty;
            _message = "اتصال SQL برقرار شد و جداول پایه ایجاد شدند. اکنون تنظیم Active Directory را تکمیل کنید.";
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "اتصال یا آماده‌سازی پایگاه داده");
        }
        finally
        {
            // رمز SQL پس از هر تلاش از حافظه مدل فرم پاک می‌شود.
            _sqlModel.Password = string.Empty;
            _isBusy = false;
        }
    }

    /// <summary>
    /// ذخیره تنظیمات AD، آزمون اتصال و تکمیل ویزارد در صورت موفقیت.
    /// </summary>
    private async Task SaveAndTestActiveDirectoryAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            var groups = _adModel.AllowedGroupsText
                .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(line => line.Split('|', 2, StringSplitOptions.TrimEntries))
                .Where(parts => parts.Length == 2)
                .Select(parts => new FleetManagement.Infrastructure.Configuration.ActiveDirectoryGroup
                {
                    Name = parts[0],
                    DistinguishedName = parts[1]
                })
                .ToList();

            if (groups.Count == 0)
            {
                throw new InvalidOperationException("حداقل یک گروه مجاز AD باید معرفی شود.");
            }

            var savedConfiguration = await ActiveDirectorySettings.GetAsync();
            var serviceAccountPassword = string.IsNullOrWhiteSpace(_adModel.ServiceAccountPassword)
                ? savedConfiguration?.ServiceAccountPassword ?? string.Empty
                : _adModel.ServiceAccountPassword;

            if (string.IsNullOrWhiteSpace(serviceAccountPassword))
            {
                throw new InvalidOperationException("رمز حساب سرویس AD الزامی است.");
            }

            var configuration = new FleetManagement.Infrastructure.Configuration.ActiveDirectoryConfiguration
            {
                DomainDnsName = _adModel.DomainDnsName,
                LdapServer = _adModel.LdapServer,
                Port = _adModel.Port,
                UseLdaps = _adModel.UseLdaps,
                BaseDistinguishedName = _adModel.BaseDistinguishedName,
                ServiceAccountUsername = _adModel.ServiceAccountUsername,
                ServiceAccountPassword = serviceAccountPassword,
                OrganizationalUnitAttribute = _adModel.OrganizationalUnitAttribute,
                UseWindowsIntegratedAuthentication = _adModel.UseWindowsIntegratedAuthentication,
                AllowUsernamePasswordFallback = _adModel.AllowUsernamePasswordFallback,
                AllowedGroups = groups
            };

            configuration.IsConnectionVerified = false;
            await ActiveDirectorySettings.SaveAsync(configuration);
            await ActiveDirectoryTester.TestAsync(configuration);
            configuration.IsConnectionVerified = true;
            await ActiveDirectorySettings.SaveAsync(configuration);
            _adReady = true;
            _adModel.ServiceAccountPassword = string.Empty;
            _message = "اتصال Active Directory تأیید شد. اکنون مشخصات سازمان را ثبت کنید.";
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "ذخیره یا آزمون Active Directory");
        }
        finally
        {
            _adModel.ServiceAccountPassword = string.Empty;
            _isBusy = false;
        }
    }

    /// <summary>
    /// تکمیل راه‌اندازی با AD غیرفعال یا موقتاً در دسترس‌نبودن آن.
    /// ورود کاربران عادی تا تنظیم موفق AD مسدود خواهد بود.
    /// </summary>
    private async Task SkipActiveDirectoryAsync()
    {
        _isBusy = true;
        try
        {
            await ActiveDirectorySettings.MarkSkippedAsync();
            _adReady = true;
            _message = "مرحله AD رد شد. ورود کاربران عادی تا پیکربندی AD غیرفعال خواهد بود. اکنون مشخصات سازمان را ثبت کنید.";
            _isError = false;
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "ثبت عبور از تنظیم AD");
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// دریافت و اعتبارسنجی فایل نشان سازمان در مرورگر.
    /// </summary>
    private async Task LogoSelectedAsync(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;

            if (file.ContentType is not ("image/png" or "image/jpeg"))
            {
                throw new InvalidOperationException("فقط فایل PNG یا JPEG پذیرفته می‌شود.");
            }

            if (file.Size > 1_500_000)
            {
                throw new InvalidOperationException("حجم فایل نشان باید کمتر از ۱٫۵ مگابایت باشد.");
            }

            await using var stream = file.OpenReadStream(1_500_000);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            _newLogoBase64 = Convert.ToBase64String(memory.ToArray());
            _newLogoContentType = file.ContentType;
            _logoFileName = file.Name;
            _message = "فایل نشان انتخاب شد.";
            _isError = false;
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "بارگذاری نشان سازمان");
        }
    }

    /// <summary>
    /// ذخیره نام و نشان سازمان در SQL.
    /// </summary>
    private async Task SaveOrganizationAsync()
    {
        _isBusy = true;
        try
        {
            await OrganizationSettings.SaveAsync(
                new FleetManagement.Infrastructure.Configuration.OrganizationProfileConfiguration
                {
                    OrganizationName = _organizationModel.OrganizationName,
                    LogoBase64 = _newLogoBase64 ?? _existingLogoBase64,
                    LogoContentType = _newLogoContentType ?? _existingLogoContentType
                });

            _organizationReady = true;
            _message = "مشخصات سازمان ذخیره شد. اکنون تنظیم پیامک را انجام دهید یا از آن عبور کنید.";
            _isError = false;
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "ذخیره مشخصات سازمان");
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// تأیید کد مستقل مدیر فنی؛ فقط پس از تأیید، فرم محرمانه پیامک نمایش داده می‌شود.
    /// </summary>
    private async Task VerifyTechnicalAdministratorAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            _technicalAdministratorVerified = await BootstrapSetup.VerifyTechnicalAdministratorAccessAsync(
                _technicalAdministratorModel.Code,
                TechnicalAdministratorAttemptKey);

            _technicalAdministratorModel.Code = string.Empty;

            if (!_technicalAdministratorVerified)
            {
                throw new UnauthorizedAccessException("کد مدیر فنی نامعتبر یا منقضی شده است.");
            }

            _technicalAdministratorVerifiedUntilUtc = DateTimeOffset.UtcNow.AddMinutes(15);

            _message = "دسترسی مدیر فنی تأیید شد.";
            _isError = false;
        }
        catch (Exception exception)
        {
            _technicalAdministratorModel.Code = string.Empty;
            ShowUnexpectedError(exception, "تأیید دسترسی مدیر فنی");
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// ذخیره تنظیمات ADP؛ در این مرحله هیچ پیامکی ارسال نمی‌شود.
    /// </summary>
    private async Task SaveSmsSettingsAsync()
    {
        if (!HasCurrentTechnicalAdministratorAccess())
        {
            throw new UnauthorizedAccessException("برای تغییر تنظیمات پیامک، دسترسی مدیر فنی لازم است.");
        }

        _isBusy = true;
        try
        {
            var previous = await SmsSettings.GetAsync();
            var servicePassword = string.IsNullOrWhiteSpace(_smsModel.Password)
                ? previous?.Password ?? string.Empty
                : _smsModel.Password;

            var configuration = new FleetManagement.Infrastructure.Configuration.SmsProviderConfiguration
            {
                Organization = _smsModel.Organization,
                Username = _smsModel.Username,
                Password = servicePassword,
                SourceNumber = _smsModel.SourceNumber,
                MaximumRetryCount = _smsModel.MaximumRetryCount,
                RetryIntervalSeconds = _smsModel.RetryIntervalSeconds,
                StatusPollingIntervalSeconds = _smsModel.StatusPollingIntervalSeconds,
                MaximumStatusPollingAttempts = _smsModel.MaximumStatusPollingAttempts,
                ReminderLeadMinutes = _smsModel.ReminderLeadMinutes,
                EventTemplates = previous?.EventTemplates
                    ?? FleetManagement.Infrastructure.Configuration.SmsProviderConfiguration.CreateDefault().EventTemplates
            };

            await SmsSettings.SaveAsync(configuration);
            _smsReady = true;
            _smsModel.Password = string.Empty;
            _message = "تنظیمات پیامک ذخیره شد. هیچ پیامک آزمایشی ارسال نشده است.";
            _isError = false;
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "ذخیره تنظیمات پیامک");
        }
        finally
        {
            _smsModel.Password = string.Empty;
            _isBusy = false;
        }
    }

    /// <summary>
    /// ادامه راه‌اندازی بدون فعال‌سازی پیامک.
    /// </summary>
    private Task SkipSmsSettingsAsync()
    {
        if (!HasCurrentTechnicalAdministratorAccess())
        {
            throw new UnauthorizedAccessException("فقط مدیر فنی می‌تواند از مرحله پیامک عبور کند.");
        }

        return MarkSmsSkippedAsync();
    }

    private bool HasCurrentTechnicalAdministratorAccess()
    {
        ExpireTechnicalAdministratorAccess();
        return _technicalAdministratorVerified;
    }

    /// <summary>
    /// ثبت ماندگار عبور مدیر فنی از تنظیم پیامک.
    /// </summary>
    private async Task MarkSmsSkippedAsync()
    {
        _isBusy = true;
        try
        {
            await SmsSettings.MarkSkippedAsync();
            _smsReady = true;
            _message = "تنظیم پیامک رد شد؛ سامانه بدون ارسال پیامک راه‌اندازی خواهد شد.";
            _isError = false;
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "ثبت عبور از مرحله پیامک");
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// تکمیل نهایی و قفل کردن ویزارد پس از ثبت تنظیمات اصلی.
    /// </summary>
    private async Task CompleteInitialSetupAsync()
    {
        _isBusy = true;
        try
        {
            if (!_administratorVerified || !_sqlReady || !_adReady || !_organizationReady || !_smsReady)
            {
                throw new InvalidOperationException("همه مراحل ضروری راه‌اندازی باید تکمیل یا به‌صورت مجاز رد شده باشند.");
            }

            await BootstrapSetup.CompleteSetupAsync();
            _setupCompleted = true;
            _message = "راه‌اندازی اولیه تکمیل شد و مسیر ویزارد قفل شد.";
            _isError = false;
        }
        catch (Exception exception)
        {
            ShowUnexpectedError(exception, "تکمیل راه‌اندازی اولیه");
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// ثبت جزئیات فنی فقط در گزارش سرور و نمایش شناسه پیگیری به کاربر.
    /// </summary>
    private void ShowUnexpectedError(Exception exception, string operation)
    {
        var trackingId = Guid.NewGuid().ToString("N");
        Logger.LogError(exception, "خطا در عملیات {Operation}. شناسه پیگیری: {TrackingId}", operation, trackingId);
        _isError = true;
        _message = $"عملیات انجام نشد. تنظیمات را بررسی کنید یا با مدیر فنی تماس بگیرید. شناسه پیگیری: {trackingId}";
    }

